---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects.js";

const bio =
  "I'm a final-year CS student at UCR who loves getting hooked on new problems and sticks with them until they're solved. I'm language-agnostic, I learn fast and I like understanding how and why things work, not just that they do.";
const github = "https://github.com/DariALV";
const email = "darialvjs@gmail.com";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();
---

<BaseLayout>
  <header class="container">
    <h1>Dariel Álvarez</h1>
    <p class="bio">{bio}</p>
    <nav class="links">
      <a href={github}>GitHub</a>
      <a href={`mailto:${email}`}>Email</a>
      <a href={`${base}/cv.pdf`}>CV</a>
    </nav>
  </header>

  <main class="container">
    <section>
      <h2>Projects</h2>
      <div class="projects">
        {
          projects.map((project, i) => (
            <ProjectCard {...project} align={i % 2 === 0 ? "left" : "right"} />
          ))
        }
      </div>
    </section>
  </main>

  <footer class="container">
    <a href={`mailto:${email}`}>{email}</a>
    <span>{year} Dariel Álvarez</span>
  </footer>
</BaseLayout>

<style>
  header {
    padding-top: 96px;
    padding-bottom: 72px;
  }

  h1 {
    font-size: 36px;
    font-weight: 600;
  }

  .bio {
    margin-top: 12px;
    max-width: 720px;
    color: var(--muted);
    font-size: 18px;
  }

  .links {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }

  h2 {
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 40px;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 88px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 120px;
    padding-top: 24px;
    padding-bottom: 48px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
  }

  footer a {
    color: var(--muted);
  }

  footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    header {
      padding-top: 56px;
      padding-bottom: 48px;
    }

    h1 {
      font-size: 28px;
    }

    .projects {
      gap: 64px;
    }
  }
</style>
